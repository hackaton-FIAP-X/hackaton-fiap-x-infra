# ============================================================================
# Template de segredos do ambiente local (kind).
#
# COPIE este arquivo e preencha os valores. NUNCA faça commit do .env real.
#
#   cp .env.example k8s/infra/overlays/local/.env
#   cp .env.example k8s/apps/overlays/local/.env
#
# Os scripts em scripts/ fazem essa cópia automaticamente na primeira execução
# e avisam para você trocar os CHANGE_ME.
#
# Kustomize (secretGenerator) lê estes arquivos e materializa os Secret
# somente dentro do cluster — nada de texto plano no repositório.
# ============================================================================

# ---- Infra de apoio (k8s/infra/overlays/local/.env) -------------------------
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_DEFAULT_USER=fiapx
RABBITMQ_DEFAULT_PASS=CHANGE_ME
MINIO_ROOT_USER=fiapxadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- Serviços da aplicação (k8s/apps/overlays/local/.env) -------------------
# Devem casar com os valores de infra acima.
# Nomes conforme os application.yml de cada serviço (não são chaves SPRING_*).
DB_USER=fiapx
DB_PASSWORD=CHANGE_ME
RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=CHANGE_ME
STORAGE_ACCESS_KEY=fiapxadmin
STORAGE_SECRET_KEY=CHANGE_ME
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME
# Obrigatório: o auth-service NÃO sobe sem isto (app.security.password-pepper).
PASSWORD_PEPPER=CHANGE_ME_pepper_aleatorio_min_32_chars
